<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- Prescription List View -->
    <record id="view_hospital_prescription_list" model="ir.ui.view">
        <field name="name">hospital.prescription.list</field>
        <field name="model">hospital.prescription</field>

        <field name="arch" type="xml">
            <list>
                <field name="name" width="220px"/>
                <field name="date" width="130px"/>
                <field name="duration" width="130px"/>
                <field name="state" width="130px"/>
            </list>
        </field>
    </record>


    <!-- Prescription Form View -->
    <record id="view_hospital_prescription_form" model="ir.ui.view">
        <field name="name">hospital.prescription.form</field>
        <field name="model">hospital.prescription</field>

        <field name="arch" type="xml">

            <form>

                <header>

                    <button
                        name="action_confirm"
                        string="Confirm"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft'"/>

                    <button
                        name="action_complete"
                        string="Complete"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'confirmed'"/>

                    <button
                        name="action_reset_to_draft"
                        string="Reset to Draft"
                        type="object"
                        invisible="state == 'draft'"/>

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,confirmed,completed"/>

                </header>

                <sheet>

                    <group>

                        <group>
                            <field name="name"/>
                            <field name="date"/>
                            <field name="duration"/>
                        </group>

                        <group>
                            <field name="state"/>
                        </group>

                    </group>

                    <notebook>

                        <page string="Medicines">
                            <field name="medicine"/>
                        </page>

                        <page string="Instructions">
                            <field name="instructions"/>
                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>
    </record>


    <!-- Prescription Search View -->
    <record id="view_hospital_prescription_search" model="ir.ui.view">
        <field name="name">hospital.prescription.search</field>
        <field name="model">hospital.prescription</field>

        <field name="arch" type="xml">

            <search>

                <field name="name"/>
                <field name="date"/>

                <!-- Filters -->
                <filter
                    name="filter_draft"
                    string="Draft"
                    domain="[('state', '=', 'draft')]"/>

                <filter
                    name="filter_confirmed"
                    string="Confirmed"
                    domain="[('state', '=', 'confirmed')]"/>

                <filter
                    name="filter_completed"
                    string="Completed"
                    domain="[('state', '=', 'completed')]"/>

                <!-- Group By -->
                <group expand="0" string="Group By">

                    <filter
                        name="group_by_state"
                        string="Status"
                        context="{'group_by': 'state'}"/>

                    <filter
                        name="group_by_date"
                        string="Date"
                        context="{'group_by': 'date'}"/>

                </group>

            </search>

        </field>
    </record>


    <!-- Prescription Action -->
    <record id="action_hospital_prescriptions" model="ir.actions.act_window">

        <field name="name">Prescriptions</field>
        <field name="res_model">hospital.prescription</field>
        <field name="view_mode">list,form</field>

    </record>


    <!-- Prescription Menu -->
    <menuitem
        id="menu_hospital_prescription"
        name="Prescriptions"
        parent="menu_hospital_management"
        action="action_hospital_prescriptions"
        sequence="20"/>

</odoo>