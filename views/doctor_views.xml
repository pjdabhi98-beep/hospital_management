<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- ========================================================= -->
    <!-- Doctor List View -->
    <!-- ========================================================= -->

    <record id="view_hospital_doctor_list" model="ir.ui.view">

        <field name="name">hospital.doctor.list</field>
        <field name="model">hospital.doctor</field>

        <field name="arch" type="xml">

            <list string="Doctors">

                <field name="name"
                       string="Doctor Name"
                       width="180"/>

                <field name="specialization"
                       string="Specialization"
                       width="180"/>

                <field name="phone"
                       string="Phone"
                       width="130"/>

                <field name="email"
                       string="Email"
                       width="220"/>

                <field name="license_number"
                       string="License Number"
                       width="150"/>

                <field name="experience"
                       string="Experience"
                       width="110"/>

                <field name="gender"
                       string="Gender"
                       width="100"/>

                <field name="joining_date"
                       string="Joining Date"
                       width="130"/>

                <field name="is_available"
                       string="Available"
                       width="110"/>

                <field name="active"
                       string="Active"
                       width="90"/>

            </list>

        </field>
    </record>


    <!-- ========================================================= -->
    <!-- Doctor Form View -->
    <!-- ========================================================= -->

    <record id="view_hospital_doctor_form" model="ir.ui.view">

        <field name="name">hospital.doctor.form</field>
        <field name="model">hospital.doctor</field>

        <field name="arch" type="xml">

            <form string="Doctor">

                <sheet>

                    <!-- Doctor Information -->

                    <group string="Doctor Information">

                        <group>

                            <field name="name"/>

                            <field name="specialization"/>

                            <field name="license_number"/>

                            <field name="experience"/>

                        </group>

                        <group>

                            <field name="gender"/>

                            <field name="joining_date"/>

                            <field name="is_available"/>

                            <field name="active"/>

                        </group>

                    </group>


                    <!-- Contact Information -->

                    <group string="Contact Information">

                        <group>

                            <field name="phone"/>

                        </group>

                        <group>

                            <field name="email"/>

                        </group>

                    </group>

                </sheet>

            </form>

        </field>
    </record>


    <!-- ========================================================= -->
    <!-- Doctor Search View -->
    <!-- ========================================================= -->

    <record id="view_hospital_doctor_search" model="ir.ui.view">

        <field name="name">hospital.doctor.search</field>
        <field name="model">hospital.doctor</field>

        <field name="arch" type="xml">

            <search string="Search Doctors">

                <!-- Search Fields -->

                <field name="name"
                       string="Doctor Name"/>

                <field name="specialization"
                       string="Specialization"/>

                <field name="phone"
                       string="Phone"/>

                <field name="email"
                       string="Email"/>

                <field name="license_number"
                       string="License Number"/>


                <!-- Filters -->

                <filter
                    name="available"
                    string="Available"
                    domain="[('is_available', '=', True)]"
                />

                <filter
                    name="unavailable"
                    string="Unavailable"
                    domain="[('is_available', '=', False)]"
                />

                <filter
                    name="active"
                    string="Active"
                    domain="[('active', '=', True)]"
                />

                <filter
                    name="inactive"
                    string="Inactive"
                    domain="[('active', '=', False)]"
                />


                <!-- Group By -->

                <group>

                    <filter
                        name="group_specialization"
                        string="Specialization"
                        context="{'group_by': 'specialization'}"
                    />

                    <filter
                        name="group_gender"
                        string="Gender"
                        context="{'group_by': 'gender'}"
                    />

                </group>

            </search>

        </field>
    </record>


    <!-- ========================================================= -->
    <!-- Doctor Window Action -->
    <!-- ========================================================= -->

    <record id="action_hospital_doctor"
            model="ir.actions.act_window">

        <field name="name">Doctors</field>
        <field name="res_model">hospital.doctor</field>
        <field name="view_mode">list,form</field>

        <field name="search_view_id"
               ref="view_hospital_doctor_search"/>

    </record>


    <!-- ========================================================= -->
    <!-- Doctor Menu -->
    <!-- ========================================================= -->

    <menuitem
        id="menu_hospital_doctor"
        name="Doctors"
        parent="menu_hospital_management_root"
        action="action_hospital_doctor"
        sequence="20"
    />

</odoo>