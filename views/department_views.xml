<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- Department List View -->
    <record id="view_hospital_department_list" model="ir.ui.view">
        <field name="name">hospital.department.list</field>
        <field name="model">hospital.department</field>

        <field name="arch" type="xml">
            <list>
                <field name="name" width="250px"/>
                <field name="code" width="150px"/>
                <field name="active" width="100px"/>
            </list>
        </field>
    </record>


    <!-- Department Form View -->
    <record id="view_hospital_department_form" model="ir.ui.view">
        <field name="name">hospital.department.form</field>
        <field name="model">hospital.department</field>

        <field name="arch" type="xml">
            <form>
                <sheet>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="active"/>
                        </group>

                        <group>
                            <field name="description"/>
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>


    <!-- Department Search View -->
    <record id="view_hospital_department_search" model="ir.ui.view">
        <field name="name">hospital.department.search</field>
        <field name="model">hospital.department</field>

        <field name="arch" type="xml">
            <search>

                <field name="name"/>
                <field name="code"/>

                <!-- Filters -->
                <filter
                    name="filter_active"
                    string="Active"
                    domain="[('active', '=', True)]"/>

                <filter
                    name="filter_inactive"
                    string="Inactive"
                    domain="[('active', '=', False)]"/>

                <!-- Group By -->
                <group expand="0" string="Group By">

                    <filter
                        name="group_by_active"
                        string="Active Status"
                        context="{'group_by': 'active'}"/>

                </group>

            </search>
        </field>
    </record>


    <!-- Department Action -->
    <record id="action_hospital_departments" model="ir.actions.act_window">

        <field name="name">Departments</field>
        <field name="res_model">hospital.department</field>
        <field name="view_mode">list,form</field>

    </record>


    <!-- Main Menu -->
    <menuitem
        id="menu_hospital_management"
        name="Hospital Management"
        sequence="10"/>


    <!-- Department Menu -->
    <menuitem
        id="menu_hospital_department"
        name="Departments"
        parent="menu_hospital_management"
        action="action_hospital_departments"
        sequence="10"/>

</odoo>