<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- ===================================================== -->
    <!-- Consultation List View -->
    <!-- ===================================================== -->

    <record id="view_hospital_consultation_list" model="ir.ui.view">
        <field name="name">hospital.consultation.list</field>
        <field name="model">hospital.consultation</field>
        <field name="arch" type="xml">

            <list string="Consultations">

                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="appointment_id"/>
                <field name="consultation_date"/>
                <field name="state"/>

            </list>

        </field>
    </record>


    <!-- ===================================================== -->
    <!-- Consultation Form View -->
    <!-- ===================================================== -->

    <record id="view_hospital_consultation_form" model="ir.ui.view">
        <field name="name">hospital.consultation.form</field>
        <field name="model">hospital.consultation</field>
        <field name="arch" type="xml">

            <form string="Consultation">

                <header>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,in_progress,completed"/>

                </header>

                <sheet>

                    <group>

                        <group>
                            <field name="name"/>
                            <field name="patient_id"/>
                            <field name="doctor_id"/>
                        </group>

                        <group>
                            <field name="appointment_id"/>
                            <field name="consultation_date"/>
                            <field name="state"/>
                        </group>

                    </group>

                    <notebook>

                        <page string="Symptoms &amp; Diagnosis">

                            <group>

                                <field name="symptoms"
                                       placeholder="Enter patient's symptoms..."/>

                                <field name="diagnosis"
                                       placeholder="Enter diagnosis..."/>

                            </group>

                        </page>


                        <page string="Doctor Notes">

                            <field name="notes"
                                   placeholder="Enter doctor's notes..."/>

                        </page>
                        <page string="Prescriptions">

    <field name="prescription_ids">
        <list editable="bottom">
            <field name="name"/>
        <field name="medicine"/>
        <field name="duration"/>
        </list>
    </field>

</page>

                    </notebook>

                </sheet>

            </form>

        </field>
    </record>


    <!-- ===================================================== -->
    <!-- Consultation Action -->
    <!-- ===================================================== -->

    <record id="action_hospital_consultation" model="ir.actions.act_window">

        <field name="name">Consultations</field>
        <field name="res_model">hospital.consultation</field>
        <field name="view_mode">list,form</field>

    </record>


    <!-- ===================================================== -->
    <!-- Consultation Menu -->
    <!-- ===================================================== -->

    <menuitem
        id="menu_hospital_consultation"
        name="Consultations"
        parent="menu_hospital_management_root"
        action="action_hospital_consultation"
        sequence="40"/>

</odoo>